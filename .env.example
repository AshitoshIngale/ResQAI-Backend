# ResQAI backend configuration - copy to .env to activate.
# Loaded automatically at startup; OS environment variables override it.
# NEVER commit a filled .env.

# --- MongoDB ---
# Local:
spring.data.mongodb.uri=mongodb://localhost:27017
# MongoDB Atlas (hosted database):
# spring.data.mongodb.uri=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
spring.data.mongodb.database=resqai

# --- JWT (generate: openssl rand -base64 48) ---
resqai.jwt.secret=REPLACE_WITH_BASE64_SECRET_AT_LEAST_48_BYTES

# --- Email (production; unset = TEST MODE) ---
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=REPLACE
# spring.mail.password=REPLACE
# resqai.mail.from=no-reply@your-domain.com

# --- SMS (production) ---
# resqai.sms.provider=twilio
# resqai.sms.twilio.account-sid=ACxxxxxxxx
# resqai.sms.twilio.auth-token=xxxxxxxx
# resqai.sms.twilio.from-number=+1xxxxxxxxxx

# --- CORS (browsers only) ---
resqai.cors.allowed-origins=
